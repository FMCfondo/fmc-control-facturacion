# Variables de entorno — copiar a .env.local (NO subir a GitHub).
# Valores en: Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role: SOLO servidor. Nunca exponer en el navegador ni en GitHub.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Envío de correos por Gmail (SOLO servidor). Crear "Contraseña de aplicación" en Google.
GMAIL_USER=facturacion@fondomutuodecobertura.com
GMAIL_APP_PASSWORD=la-contrasena-de-aplicacion-de-16-caracteres

# ── OBLIGATORIA ─────────────────────────────────────────────────────────────
# Correos autorizados, separados por comas. Es la allowlist de la aplicación y
# FALLA CERRADO: si no está definida, NADIE entra (ni siquiera el dueño).
# Tiene que estar en TODOS los entornos de Vercel donde la app deba funcionar,
# incluido Preview — Vercel no copia las variables entre entornos.
ALLOWED_EMAILS=tu-correo@ejemplo.com

# ── OPCIONALES ──────────────────────────────────────────────────────────────
# Origen público de la app. Se usa para el logo del PDF y para la URL que queda
# dentro de los correos. Si no está, se deduce del Host con una lista de hosts
# de confianza (ver lib/origen.js).
# APP_URL=https://facturacion.fondomutuodecobertura.com

# Tope ABSOLUTO de sesión en horas (por defecto 12). Aparte del tope de
# inactividad de 2 h. Ver lib/sesion.js.
# SESION_MAX_HORAS=12

# Llave dedicada para firmar la cookie de actividad. Si no está, se DERIVA de
# SUPABASE_SERVICE_ROLE_KEY con HKDF (el control nunca queda apagado por una
# variable que falte). Definirla es lo recomendado; cualquier cadena larga y
# aleatoria sirve. Cambiarla cierra todas las sesiones abiertas.
# SESSION_SECRET=una-cadena-larga-y-aleatoria
